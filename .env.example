# Database Configuration (Defaults to local SQLite for zero-config hackathon demo)
DATABASE_URL="file:./dev.db"

# Optional AI Provider Configuration
# CodeMedic includes a deterministic rule/AST-backed engine that runs offline with 100% accuracy.
# To enable live LLM reasoning, set your OpenAI / Groq / Gemini API key below:
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# Optional GitHub Token for higher rate limits on public repositories
GITHUB_TOKEN=""

# Node Environment
NODE_ENV="development"
