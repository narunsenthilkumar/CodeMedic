# ========================================================
# CodeMedic Environment Configuration (.env.example)
# ========================================================

# 1. Database Configuration
# Local SQLite for zero-config hackathon demo and standalone VM/container deployment:
DATABASE_URL="file:./dev.db"
# Or PostgreSQL for distributed cloud container deployments:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/codemedic?schema=public"

# 2. Node & Server Configuration
NODE_ENV="development"
PORT=3000

# 3. AI Reasoning Engine (Optional)
# CodeMedic includes an offline deterministic rule/AST heuristic engine that runs with 100% accuracy without API keys.
# To optionally enable live LLM reasoning (OpenAI, Groq, Gemini via OpenAI-compatible API):
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# 4. GitHub API Integration (Optional)
# Recommended if cloning many public repositories to avoid rate limits:
GITHUB_TOKEN=""

# 5. Sandbox Execution Engine
# Maximum execution time per command inside the isolated workspace (milliseconds):
SANDBOX_TIMEOUT_MS=60000
