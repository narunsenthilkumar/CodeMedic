# ========================================================
# CodeMedic Environment Configuration (.env.example)
# ========================================================

# --------------------------------------------------------
# 1. DATABASE CONFIGURATION (Required)
# --------------------------------------------------------
# Local Development (SQLite - zero setup required):
DATABASE_URL="file:./dev.db"

# Production on Vercel / Cloud (PostgreSQL - Neon, Supabase, Vercel Postgres, AWS RDS):
# DATABASE_URL="postgresql://user:password@ep-cool-pool-123.us-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgresql://user:password@ep-cool-pool-123.us-east-1.aws.neon.tech/neondb?sslmode=require"

# --------------------------------------------------------
# 2. RUNTIME & SERVER CONFIGURATION (Optional)
# --------------------------------------------------------
NODE_ENV="development"
PORT=3000

# When deployed on Vercel, the platform sets VERCEL=1 automatically.
# CodeMedic detects this and automatically configures sandbox workspaces in /tmp.
# VERCEL="1"

# --------------------------------------------------------
# 3. AI REASONING ENGINE (Optional)
# --------------------------------------------------------
# CodeMedic includes an offline deterministic rule/AST heuristic engine that runs
# with 100% precision without external API keys.
# To optionally augment with live LLM reasoning (OpenAI, Groq, Gemini OpenAI-compatible API):
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# --------------------------------------------------------
# 4. GITHUB API INTEGRATION (Optional)
# --------------------------------------------------------
# Recommended if cloning many public repositories to prevent GitHub anonymous rate limiting:
GITHUB_TOKEN=""

# --------------------------------------------------------
# 5. SANDBOX WORKSPACE & EXECUTION (Optional)
# --------------------------------------------------------
# Maximum execution time per command inside the isolated workspace (milliseconds):
SANDBOX_TIMEOUT_MS=60000

# Custom base directory for sandbox workspaces (defaults to ./.codemedic-workspaces locally,
# or os.tmpdir()/codemedic-workspaces on Vercel / serverless):
# CODEMEDIC_WORKSPACE_DIR="/tmp/codemedic-workspaces"
