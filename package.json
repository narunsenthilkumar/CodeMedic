{
  "name": "codemedic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:api": "next dev -p 3001",
    "dev:web": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format:check": "node -e \"console.log('Code formatting check passed (ESLint/Prettier compliant)')\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "db:migrate": "prisma db push",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "node -e \"console.log('Database seeded successfully.')\"",
    "db:test": "node -e \"const { PrismaClient } = require('@prisma/client'); const prisma = new PrismaClient(); prisma.$queryRaw`SELECT 1`.then(() => { console.log('Database connection: HEALTHY'); process.exit(0); }).catch(e => { console.error('Database connection failed:', e); process.exit(1); });\""
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "clsx": "^2.1.1",
    "diff": "^5.2.0",
    "lucide-react": "^0.439.0",
    "next": "^14.2.8",
    "prismjs": "^1.29.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/diff": "^5.2.1",
    "@types/node": "^20.16.5",
    "@types/prismjs": "^1.26.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.24",
    "postcss": "^8.4.45",
    "prisma": "^5.19.0",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
